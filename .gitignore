# Secrets
# `.env*` et non `.env` : un `.env.bak`, `.env.local` ou `.env.old` porte les
# mêmes secrets et n'était PAS couvert — vérifié le 2026-08-17, une sauvegarde
# `.env.bak-crlf` apparaissait en untracked, donc à un `git add -A` du commit.
.env*
# ...sauf le modèle sans valeurs, qui doit rester versionné.
!.env.example

# Environnement Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Données (rejouées/téléchargées — jamais versionnées)
data/*.csv
data/incoming/
data/olist/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
# dbt écrit aussi ici quand il est lancé depuis la racine du dépôt
logs/

# Checkpoints LangGraph (SQLite)
*.sqlite
*.sqlite3
*.db

# Airflow
airflow/logs/

# Divers
.DS_Store
